# Backend
PORT=4000
JWT_SECRET=vana-ops-demo-secret

# Prometheus (consulta desde el backend)
PROMETHEUS_URL=http://localhost:9090

# Grafana (enlaces en el frontend)
GRAFANA_URL=http://localhost:3000
GRAFANA_DASHBOARD_URL=http://localhost:3000/d/vana-ops/vana-ops-console

# --- Jira Cloud (recomendado si ya tienes cuenta) ---
# 1) URL de tu sitio, ej: https://tu-empresa.atlassian.net
# 2) JIRA_USER = tu email de Atlassian
# 3) JIRA_PASSWORD = API token (NO la contraseña de login)
#    Crear token: https://id.atlassian.com/manage-profile/security/api-tokens
# 4) JIRA_PROJECT_KEY = clave del proyecto (ej. VANA, PROJ)
JIRA_BASE_URL=https://TU-SITIO.atlassian.net
JIRA_USER=tu-email@ejemplo.com
JIRA_PASSWORD=tu_api_token_aqui
JIRA_PROJECT_KEY=VANA

# --- Alternativa: Jira local Docker ---
# JIRA_BASE_URL=http://localhost:8080
# JIRA_USER=admin
# JIRA_PASSWORD=vana2026
# JIRA_PROJECT_KEY=VANA
